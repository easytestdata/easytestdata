# =============================================================================
# EasyTestData - Environment Configuration
# =============================================================================
# Every environment variable the server, the CLI and the marketing build read. Local mode
# (`npx easytestdata ui`, `pnpm run dev`) needs no .env at all; EasyTestData Cloud copies this
# file to .env and fills it in (docs/deploy-cloudpanel.md). Commented lines show the default.
# NEVER commit .env to version control.

# --- Mode ---
# cloud | local. Unset: cloud when DATABASE_URL is set, else local. EasyTestData Cloud applies
# per-team abuse limits (3 connections, 10 loads/month, 5,000 records/job, 5 members). Local mode
# has no sign-in and no limits, listens on 127.0.0.1 only (default port 28080), keeps its
# database, secret key and downloads in EASYTESTDATA_DATA_DIR (default ~/.easytestdata) and
# ignores DATABASE_URL. On a Cloud server also set NODE_ENV to production.
DEPLOYMENT=
# EASYTESTDATA_DATA_DIR=
# Cloud: postgresql://<user>:<password>@127.0.0.1:5432/<db> (URL-encode special characters).
# Setting it selects Cloud mode unless DEPLOYMENT says otherwise.
# DATABASE_URL=

# --- QBO OAuth Credentials (required to connect QuickBooks Online sandboxes) ---
# The app starts without them (generating and downloading data still works); local mode can
# also take them on its setup screen. Use the sandbox (development) keys of your Intuit
# developer app and register ${APP_URL}/api/v1/connections/callback as its redirect URI.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# --- Secrets ---
# Local mode generates its own; Cloud: openssl rand -hex 32 (for each).
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
# JWT_ISSUER=easytestdata

# Comma-separated, case-insensitive emails that become admins (users.is_admin) at sign-in and at
# startup. Every stored email was verified by the sign-in provider.
ADMIN_EMAILS=

# --- Sign-in providers (Cloud; Google, GitHub and Intuit; there are no passwords) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
INTUIT_SSO_CLIENT_ID=
INTUIT_SSO_CLIENT_SECRET=

# --- Observability (error tracking only; there is no product analytics) ---
SENTRY_DSN=
SENTRY_DSN_FRONTEND=
# Log level: default debug, info when NODE_ENV is production; `easytestdata ui` defaults to warn.
# LOG_LEVEL=

# --- App (Cloud) ---
# The app's public URL, required in Cloud production, e.g. https://app.easytestdata.com (default
# http://localhost:<port>; local mode always uses that). The marketing build also reads it for its
# links into the app (default https://app.easytestdata.com).
# APP_URL=
# MARKETING_URL=https://easytestdata.com
# Cloud listens on HOST:PORT (default 0.0.0.0:3000); local mode on 127.0.0.1:28080.
# HOST=0.0.0.0
# PORT=3000
# Cloud CORS allowlist; local mode allows no cross-origin requests.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Reverse-proxy trust for client IPs (rate limiting, logs). Leave empty/false when the app is
# reached directly. Behind exactly one proxy (e.g. CloudPanel's nginx, which restores the real IP
# from Cloudflare's CF-Connecting-IP) use 1. Also accepts Express presets/subnets such as
# `loopback` or `10.0.0.0/8`. Never use `true` on an internet-facing port: clients could then
# spoof X-Forwarded-For and dodge per-IP rate limits.
TRUST_PROXY=

# --- Jobs ---
# Download files: default <EASYTESTDATA_DATA_DIR>/exports in local mode, ./data/exports in Cloud.
# JOB_ARTIFACTS_DIR=
# Download files older than this many days are deleted every 6 hours.
# JOB_ARTIFACT_TTL_DAYS=7
# QuickBooks jobs that run in parallel across teams (each team has at most one active QBO job).
# QBO_WORKER_CONCURRENCY=6
# Hard timeouts after which a running job is aborted and marked failed.
# QBO_JOB_TIMEOUT_MINUTES=60
# LOCAL_JOB_TIMEOUT_MINUTES=15
# After a timeout, how long a job gets to record what it created before it is failed outright.
# JOB_TIMEOUT_GRACE_SECONDS=60

# --- CLI (easytestdata) ---
# Set to print stack traces. Without a connection in .easytestdata.json the CLI also reads
# QBO_REFRESH_TOKEN, QBO_REALM_ID, QBO_ACCESS_TOKEN and QBO_MINOR_VERSION.
# DEBUG=1

# The optional real-sandbox check (pnpm run test:qbo-live) uses the connection that
# `npx easytestdata auth` saves; see CONTRIBUTING.md.
