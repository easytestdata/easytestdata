{
  "name": "@easytestdata/server",
  "version": "0.1.0",
  "description": "EasyTestData server: REST API and job workers for EasyTestData Cloud and local mode",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/easytestdata/easytestdata.git",
    "directory": "packages/server"
  },
  "homepage": "https://easytestdata.com",
  "bugs": {
    "url": "https://github.com/easytestdata/easytestdata/issues"
  },
  "author": "EasyTestData",
  "type": "module",
  "main": "src/server.js",
  "exports": {
    ".": "./src/server.js",
    "./local": "./src/local/start-local.js"
  },
  "files": [
    "src",
    "web-dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "echo \"No build step\"",
    "start": "node --env-file-if-exists=../../.env src/start.js",
    "dev": "DEPLOYMENT=local PORT=28080 LOCAL_PUBLIC_URL=http://localhost:5173 LOG_PRETTY=1 node --env-file-if-exists=../../.env --watch src/start.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node src/db/migrate.js",
    "prepack": "node ../../scripts/copy-web-dist.mjs",
    "postpack": "node -e \"require('node:fs').rmSync('web-dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@easytestdata/core": "workspace:*",
    "@easytestdata/qbo-client": "workspace:*",
    "@easytestdata/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@sentry/node": "^10.75.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "fflate": "^0.8",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-oauth2": "^1.8.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  }
}
